{
	// ============================================================
	//  Configurazione Cloudflare — Chillyforum
	//  Il database_id arriva da `npx wrangler d1 create chillyforum-db`.
	// ============================================================
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "chillyforum",
	"main": "src/worker.js",
	"compatibility_date": "2026-10-01",
	// Niente URL di anteprima: il sito resta raggiungibile solo dall'indirizzo protetto da Access
	"preview_urls": false,
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "chillyforum-db",
			"database_id": "c865f609-9207-4f46-9929-d89d378910d6",
			"migrations_dir": "migrations"
		}
	],
	"vars": {
		// Email degli amministratori (separate da virgola): possono gestire le persone.
		"ADMIN_EMAILS": "buizomanuel@gmail.com",
		// Cloudflare Access: dominio del team, es. "chilly.cloudflareaccess.com"
		"ACCESS_TEAM_DOMAIN": "black-surf-2fc8.cloudflareaccess.com",
		// Cloudflare Access: "Application Audience (AUD) Tag" dell'applicazione
		"ACCESS_AUD": "d08d3f496a4ec03547cead3729f2a572f96f41d1367822eb48c35ec0027720c2",
		// Lingua dei dati dei film presi da TMDB
		"TMDB_LANGUAGE": "it-IT"
	}
	// Segreto (non va qui): npx wrangler secret put TMDB_API_KEY
}